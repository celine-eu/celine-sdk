  "info": {
    "title": "Dataset API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/catalogue": {
      "post": {
        "description": "Import or update datasets in the internal catalogue.\n\nIntended for use by the CLI. Idempotent upserts on dataset_id.",
        "operationId": "import_catalogue_admin_catalogue_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogueImportModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogueImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Catalogue",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/catalogue": {
      "get": {
        "description": "Return the full DCAT-AP 3 catalog as JSON-LD (application/ld+json).\n\nOnly includes entries with expose=True. Entries with access_level='secret'\nare silently omitted even when expose=True.",
        "operationId": "list_catalogue_catalogue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Catalogue",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/catalogue/search": {
      "post": {
        "description": "Search the exposed catalogue.\n\nFilters (all optional, ANDed together):\n- q: full-text substring match on title and description\n- access_level: exact match on access_level\n- keywords: at least one keyword must appear in tags.keywords",
        "operationId": "search_catalogue_catalogue_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogueSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Catalogue",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/catalogue/{dataset_id}": {
      "get": {
        "description": "Return a single dcat:Dataset JSON-LD document.\n\nOnly exposed, non-secret entries are accessible here.\n\nOne path, two representations: a browser gets the HTML page rendered by\n`routes/views.py`, everyone else gets the document. The route is declared\nhere and only here \u2014 a second declaration of the same path in another router\nwould be dead code decided by include order, not by what the client asked\nfor.",
        "operationId": "get_catalogue_entry_catalogue__dataset_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "title": "Dataset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Catalogue Entry",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/catalogue/{dataset_id}/schema": {
      "get": {
        "description": "Return ONLY the JSON schema describing the dataset's table.",
        "operationId": "dataset_metadata_catalogue__dataset_id__schema_get",
        "parameters": [
          {
            "in": "path",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "title": "Dataset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
