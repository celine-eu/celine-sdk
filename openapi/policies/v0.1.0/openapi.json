{
  "components": {
    "schemas": {
      "Action": {
        "description": "Represents the action being performed.",
        "properties": {
          "context": {
            "additionalProperties": true,
            "description": "Action-specific context (e.g., state transitions)",
            "title": "Context",
            "type": "object"
          },
          "name": {
            "description": "Action name (read, write, subscribe, etc.)",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Action",
        "type": "object"
      },
      "AuthorizeRequest": {
        "description": "Generic authorization request.\n\nThe JWT token should be passed in the Authorization header.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action",
            "description": "Action being performed"
          },
          "context": {
            "additionalProperties": true,
            "description": "Additional context for policy evaluation",
            "title": "AuthorizeRequestContext",
            "type": "object"
          },
          "resource": {
            "$ref": "#/components/schemas/Resource",
            "description": "Resource being accessed"
          }
        },
        "required": [
          "resource",
          "action"
        ],
        "title": "AuthorizeRequest",
        "type": "object"
      },
      "AuthorizeResponse": {
        "description": "Generic authorization response.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "request_id"
        ],
        "title": "AuthorizeResponse",
        "type": "object"
      },
      "DatasetAccessRequest": {
        "description": "Request to check dataset access.",
        "properties": {
          "access_level": {
            "description": "Dataset access level",
            "enum": [
              "open",
              "internal",
              "restricted"
            ],
            "title": "Access Level",
            "type": "string"
          },
          "action": {
            "default": "read",
            "description": "Action type",
            "enum": [
              "read",
              "write",
              "admin"
            ],
            "title": "Action",
            "type": "string"
          },
          "dataset_id": {
            "description": "Dataset identifier",
            "title": "Dataset Id",
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "access_level"
        ],
        "title": "DatasetAccessRequest",
        "type": "object"
      },
      "DatasetAccessResponse": {
        "description": "Response for dataset access check.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "request_id"
        ],
        "title": "DatasetAccessResponse",
        "type": "object"
      },
      "DatasetFilterRequest": {
        "description": "Request to get row-level filters for a dataset.",
        "properties": {
          "access_level": {
            "description": "Dataset access level",
            "enum": [
              "open",
              "internal",
              "restricted"
            ],
            "title": "Access Level",
            "type": "string"
          },
          "dataset_id": {
            "description": "Dataset identifier",
            "title": "Dataset Id",
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "access_level"
        ],
        "title": "DatasetFilterRequest",
        "type": "object"
      },
      "DatasetFilterResponse": {
        "description": "Response with row-level filters.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "filters": {
            "description": "Filters to apply to queries",
            "items": {
              "$ref": "#/components/schemas/FilterPredicate"
            },
            "title": "Filters",
            "type": "array"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "request_id"
        ],
        "title": "DatasetFilterResponse",
        "type": "object"
      },
      "FilterPredicate": {
        "description": "A filter predicate for row-level access control.",
        "properties": {
          "field": {
            "description": "Field to filter on",
            "title": "Field",
            "type": "string"
          },
          "operator": {
            "description": "Comparison operator (eq, ne, in, gt, lt, etc.)",
            "title": "Operator",
            "type": "string"
          },
          "value": {
            "description": "Value to compare against",
            "title": "Value"
          }
        },
        "required": [
          "field",
          "operator",
          "value"
        ],
        "title": "FilterPredicate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health check response.",
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "policies_loaded": {
            "title": "Policies Loaded",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "policies_loaded"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MqttResponse": {
        "description": "MQTT auth/acl response.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "ok"
        ],
        "title": "MqttResponse",
        "type": "object"
      },
      "MqttSuperuserRequest": {
        "description": "MQTT superuser check request.",
        "properties": {
          "username": {
            "description": "Username",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "MqttSuperuserRequest",
        "type": "object"
      },
      "PipelineTransitionRequest": {
        "description": "Request to validate a pipeline state transition.",
        "properties": {
          "from_state": {
            "description": "Current state",
            "title": "From State",
            "type": "string"
          },
          "pipeline_id": {
            "description": "Pipeline identifier",
            "title": "Pipeline Id",
            "type": "string"
          },
          "to_state": {
            "description": "Target state",
            "title": "To State",
            "type": "string"
          }
        },
        "required": [
          "pipeline_id",
          "from_state",
          "to_state"
        ],
        "title": "PipelineTransitionRequest",
        "type": "object"
      },
      "PipelineTransitionResponse": {
        "description": "Response for pipeline state transition.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "request_id"
        ],
        "title": "PipelineTransitionResponse",
        "type": "object"
      },
      "Resource": {
        "description": "Represents the resource being accessed.",
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "description": "Resource-specific attributes",
            "title": "Attributes",
            "type": "object"
          },
          "id": {
            "description": "Resource identifier",
            "title": "Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType",
            "description": "Resource type"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "title": "Resource",
        "type": "object"
      },
      "ResourceType": {
        "description": "Types of resources that can be authorized.",
        "enum": [
          "dataset",
          "pipeline",
          "dt",
          "topic",
          "userdata"
        ],
        "title": "ResourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Centralized authorization service for the CELINE platform",
    "title": "CELINE Policy Service",
    "version": "0.1.0"
  },
