{
  "components": {
    "schemas": {
      "Action": {
        "description": "Represents the action being performed.",
        "properties": {
          "context": {
            "additionalProperties": true,
            "description": "Action-specific context (e.g., state transitions)",
            "title": "Context",
            "type": "object"
          },
          "name": {
            "description": "Action name (read, write, subscribe, etc.)",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Action",
        "type": "object"
      },
      "AuthorizeRequest": {
        "description": "Generic authorization request.\n\nThe JWT token should be passed in the Authorization header.",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action",
            "description": "Action being performed"
          },
          "context": {
            "additionalProperties": true,
            "description": "Additional context for policy evaluation",
            "title": "AuthorizeRequestContext",
            "type": "object"
          },
          "resource": {
            "$ref": "#/components/schemas/Resource",
            "description": "Resource being accessed"
          }
        },
        "required": [
          "resource",
          "action"
        ],
        "title": "AuthorizeRequest",
        "type": "object"
      },
      "AuthorizeResponse": {
        "description": "Generic authorization response.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "allowed",
          "request_id"
        ],
        "title": "AuthorizeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Health check response.",
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "policies_loaded": {
            "title": "Policies Loaded",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "policies_loaded"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MqttAclRequest": {
        "description": "MQTT ACL check request (mosquitto-go-auth format).\n\nmosquitto ACL checks use a bitmask:\n- MOSQ_ACL_READ      0x01\n- MOSQ_ACL_WRITE     0x02\n- MOSQ_ACL_SUBSCRIBE 0x04",
        "properties": {
          "acc": {
            "description": "Access mask (READ|WRITE|SUBSCRIBE)",
            "maximum": 7.0,
            "minimum": 0.0,
            "title": "Acc",
            "type": "integer"
          },
          "clientid": {
            "default": "",
            "description": "MQTT client ID",
            "title": "Clientid",
            "type": "string"
          },
          "topic": {
            "description": "MQTT topic",
            "title": "Topic",
            "type": "string"
          }
        },
        "required": [
          "topic",
          "acc"
        ],
        "title": "MqttAclRequest",
        "type": "object"
      },
      "MqttResponse": {
        "description": "MQTT auth/acl response.",
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "ok"
        ],
        "title": "MqttResponse",
        "type": "object"
      },
      "MqttSuperuserRequest": {
        "description": "MQTT superuser check request.",
        "properties": {
          "username": {
            "description": "Username",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "MqttSuperuserRequest",
        "type": "object"
      },
      "Resource": {
        "description": "Represents the resource being accessed.",
        "properties": {
          "attributes": {
            "additionalProperties": true,
            "description": "Resource-specific attributes",
            "title": "Attributes",
            "type": "object"
          },
          "id": {
            "description": "Resource identifier",
            "title": "Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ResourceType",
            "description": "Resource type"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "title": "Resource",
        "type": "object"
      },
      "ResourceType": {
        "description": "Types of resources that can be authorized.",
        "enum": [
          "dataset",
          "pipeline",
          "dt",
          "topic",
          "userdata"
        ],
        "title": "ResourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Centralized authorization service for the CELINE platform",
    "title": "CELINE Policy Service",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/authorize": {
      "post": {
        "description": "Authorize a resource action.\n\nPolicy routing:\n- Specialized policies are tried first (celine.{resource.type})\n- Falls back to generic policy (celine.authz) if not found\n\nScope derivation (in generic policy):\n    {resource.type}.{resource.attributes.resource_type}.{action.name}\n\nExamples:\n    - type=dataset \u2192 celine.dataset (specialized, has access_level logic)\n    - type=dt, resource_type=simulation, action=read \u2192 celine.authz \u2192 dt.simulation.read\n    - type=pipeline, resource_type=status, action=write \u2192 celine.authz \u2192 pipeline.status.write",
        "operationId": "authorize_authorize_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-request-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "in": "header",
            "name": "x-source-service",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Source-Service"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authorize",
        "tags": [
          "authorization"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness check.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
