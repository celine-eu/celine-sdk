  "info": {
    "title": "nudging-tool-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/ingest-event": {
      "post": {
        "description": "Accepts an enriched Digital Twin event, evaluates nudging rules, and dispatches deliveries for any triggered nudges.",
        "operationId": "ingest_event_admin_ingest_event_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DigitalTwinEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestOkResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestAcceptedResponse"
                }
              }
            },
            "description": "Nudges created but all deliveries suppressed by the orchestrator"
          },
          "204": {
            "description": "No rules triggered"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestErrorDetail"
                }
              }
            },
            "description": "Unknown scenario"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestErrorDetail"
                }
              }
            },
            "description": "All rules suppressed by dedup"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestErrorDetail"
                }
              }
            },
            "description": "Invalid or missing facts"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestErrorDetail"
                }
              }
            },
            "description": "Unexpected engine failure"
          }
        },
        "summary": "Ingest a Digital Twin event",
        "tags": [
          "admin",
          "admin"
        ]
      }
    },
    "/admin/notifications": {
      "get": {
        "description": "Admin view of all notifications. Filterable by user_id, family, severity. Requires nudging.admin scope or admin group.",
        "operationId": "admin_list_notifications_admin_notifications_get",
        "parameters": [
          {
            "description": "Filter by user ID",
            "in": "query",
            "name": "user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by user ID",
              "title": "User Id"
            }
          },
          {
            "description": "Filter by family (energy, onboarding, \u2026)",
            "in": "query",
            "name": "family",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by family (energy, onboarding, \u2026)",
              "title": "Family"
            }
          },
          {
            "description": "Filter by severity (info, warning, critical)",
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity (info, warning, critical)",
              "title": "Severity"
            }
          },
          {
            "description": "Include soft-deleted notifications",
            "in": "query",
            "name": "include_deleted",
            "required": false,
            "schema": {
              "default": false,
              "description": "Include soft-deleted notifications",
              "title": "Include Deleted",
              "type": "boolean"
            }
          },
          {
            "description": "Return only unread notifications",
            "in": "query",
            "name": "unread_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "Return only unread notifications",
              "title": "Unread Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
