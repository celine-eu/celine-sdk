    "/admin/export": {
      "get": {
        "operationId": "admin_export_admin_export_get",
        "parameters": [
          {
            "description": "Community key",
            "in": "query",
            "name": "community",
            "required": true,
            "schema": {
              "description": "Community key",
              "title": "Community",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Admin Export",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/import": {
      "post": {
        "description": "Replacement import of a REC YAML bundle.\n\n- Deletes existing community graph (by community.key)\n- Recreates it atomically",
        "operationId": "admin_import_admin_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Admin Import",
        "tags": [
          "admin"
        ]
      }
    },
